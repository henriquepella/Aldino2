# ===================================================================
#  Plataforma de Análise Geoestatística — variáveis de ambiente
#  Copie para .env e ajuste. Todos têm padrão para desenvolvimento local.
# ===================================================================

# ---- Identidade ----
APP_ENV=development                 # development | production | test
DEBUG=true

# ---- Segurança (OBRIGATÓRIO trocar em produção) ----
SECRET_KEY=dev-insecure-change-me-please-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_REGISTRATION=true

# ---- Banco de dados ----
# Local (padrão): SQLite dentro de ./backend/storage
DATABASE_URL=sqlite:///./storage/app.db
# Produção (docker-compose): PostgreSQL + PostGIS
# DATABASE_URL=postgresql+psycopg2://geo:geo@db:5432/geo

# ---- Armazenamento de arquivos ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# ---- Jobs assíncronos ----
JOB_BACKEND=thread                  # thread (local) | celery (produção)
JOB_MAX_WORKERS=2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Padrões científicos ----
DEFAULT_N_PERMUTATIONS=999
DEFAULT_ALPHA=0.05
DEFAULT_KNN_K=8
DEFAULT_IDW_POWER=2.0
DEFAULT_IDW_NEIGHBORS=12
DEFAULT_VARIOGRAM_BINS=15
DEFAULT_GRID_RESOLUTION=80
REPORT_MAP_DPI=150
# Mapa-base dos mapas (requer internet ao renderizar; 'none' desativa):
# satellite | gray | streets | topo | terrain | osm | none
DEFAULT_BASEMAP=satellite

# ---- CORS / Frontend ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Conta demo (seed) ----
DEMO_EMAIL=demo@demo.local
DEMO_PASSWORD=demo12345

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api
